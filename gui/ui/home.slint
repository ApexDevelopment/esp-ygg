import { MaterialPalette, MaterialText, MaterialTypography, OutlinedCard } from "@material";
import { Node } from "state.slint";

/// A count with what it counts, on a card.
component Stat inherits OutlinedCard {
    in property <int> count;
    in property <string> label;

    VerticalLayout {
        padding: 8px;
        spacing: 2px;

        MaterialText {
            text: root.count;
            style: MaterialTypography.headline_small;
        }

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_small;
            color: MaterialPalette.on_surface_variant;
        }
    }
}

export component HomePage inherits VerticalLayout {
    padding: 16px;
    spacing: 12px;
    alignment: start;

    VerticalLayout {
        spacing: 4px;

        MaterialText {
            text: Node.name;
            style: MaterialTypography.title_large;
            overflow: elide;
        }

        MaterialText {
            text: Node.address == "" ? "Starting…" : Node.address;
            style: MaterialTypography.body_small;
            color: MaterialPalette.on_surface_variant;
            wrap: char_wrap;
        }
    }

    HorizontalLayout {
        spacing: 8px;

        Stat {
            count: Node.neighbor_count;
            label: "neighbors";
        }

        Stat {
            count: Node.peer_count;
            label: "peers";
        }

        Stat {
            count: Node.known_count;
            label: "known";
        }
    }

    if Node.address != "": MaterialText {
        text: "up \{Node.uptime} · \{Node.free_memory} KB free";
        style: MaterialTypography.body_small;
        color: MaterialPalette.on_surface_variant;
    }
}
