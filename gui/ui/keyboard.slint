import { MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";
import { Keyboard } from "state.slint";

export enum KeyStyle {
    /// Types a character.
    letter,
    /// Changes what the keys type, or deletes.
    function,
    /// Enter, the key that finishes.
    action,
}

/// The colors of a key's face and its label, unpressed and pressed.
component KeyColors {
    in property <KeyStyle> key_style: KeyStyle.letter;
    in property <bool> pressed;

    out property <color> face: (root.key_style == KeyStyle.action ? MaterialPalette.primary
        : root.key_style == KeyStyle.function ? MaterialPalette.secondary_container
        : MaterialPalette.surface_container_highest).mix(self.ink, root.pressed ? 0.7 : 1.0);
    out property <color> ink: root.key_style == KeyStyle.action ? MaterialPalette.on_primary
        : root.key_style == KeyStyle.function ? MaterialPalette.on_secondary_container
        : MaterialPalette.on_surface;
}

/// A key on its own, with a label or an icon, lit while it is held. Most
/// keys are in rows of characters instead, which cost less.
component Key inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <KeyStyle> key_style: KeyStyle.letter;

    callback clicked();

    colors := KeyColors {
        key_style: root.key_style;
        pressed: touch.pressed;
    }

    // As wide as a character's key, unless given more
    horizontal_stretch: 1;
    border_radius: 8px;
    background: colors.face;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        source: root.icon;
        colorize: colors.ink;
    }

    Text {
        text: root.text;
        // Words, such as ?123, in a smaller size than single characters
        font_size: root.text.character_count > 1 ? 14px : 16px;
        color: colors.ink;
        horizontal_alignment: center;
        vertical_alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// A row of keys that type their own text, sharing the row's width. One
/// touch area serves the whole row, working out the key from where the
/// finger is, which costs much less than one for each key.
component Characters inherits Rectangle {
    in property <[string]> characters;
    in property <bool> upper;

    callback typed(string);

    property <length> slot: self.width / root.characters.length;
    /// The key being held, or -1.
    property <int> held: touch.pressed ? floor(touch.pressed_x / root.slot) : -1;

    for character[index] in root.characters: Rectangle {
        x: index * root.slot + 2px;
        width: root.slot - 4px;
        border_radius: 8px;
        background: MaterialPalette.surface_container_highest.mix(MaterialPalette.on_surface, index == root.held ? 0.7 : 1.0);

        Text {
            text: root.upper ? character.to_uppercase() : character;
            font_size: 16px;
            color: MaterialPalette.on_surface;
            horizontal_alignment: center;
            vertical_alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            let index = floor(self.pressed_x / root.slot);
            if index >= 0 && index < root.characters.length {
                let character = root.characters[index];
                root.typed(root.upper ? character.to_uppercase() : character);
            }
        }
    }
}

/// The keyboard, over the whole screen, with the setting being typed
/// shown at the top, as on a phone held sideways.
export component OnScreenKeyboard inherits Rectangle {
    /// Shift lasts one letter.
    property <bool> shifted;
    /// 0 for letters, 1 for digits and symbols, 2 for more symbols.
    property <int> layer;

    function type(text: string) {
        Keyboard.key(text);
        root.shifted = false;
    }

    function enter() {
        Keyboard.key(Key.Return);
    }

    background: MaterialPalette.surface_container;

    VerticalLayout {
        padding: 2px;
        spacing: 4px;

        HorizontalLayout {
            height: 44px;
            padding_left: 8px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                horizontal_stretch: 1;

                MaterialText {
                    text: Keyboard.error != "" ? Keyboard.error : Keyboard.label;
                    style: MaterialTypography.label_medium;
                    color: Keyboard.error != "" ? MaterialPalette.error : MaterialPalette.primary;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 1px;

                    MaterialText {
                        text: Keyboard.text;
                        style: MaterialTypography.body_large;
                    }

                    // The cursor, always at the end
                    Rectangle {
                        width: 2px;
                        background: MaterialPalette.primary;
                    }
                }
            }

            Key {
                width: 56px;
                icon: @image-url("../icons/close.svg");
                key_style: KeyStyle.function;

                clicked => {
                    Keyboard.cancel();
                }
            }
        }

        if Keyboard.numeric: VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 3;
                    characters: ["1", "2", "3"];
                    typed(text) => { root.type(text); }
                }

                Key {
                    icon: @image-url("../icons/backspace.svg");
                    key_style: KeyStyle.function;
                    clicked => { Keyboard.key(Key.Backspace); }
                }
            }

            HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 3;
                    characters: ["4", "5", "6"];
                    typed(text) => { root.type(text); }
                }

                Key {
                    text: "-";
                    key_style: KeyStyle.function;
                    clicked => { root.type(self.text); }
                }
            }

            HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 3;
                    characters: ["7", "8", "9"];
                    typed(text) => { root.type(text); }
                }

                Key {
                    text: "+";
                    key_style: KeyStyle.function;
                    clicked => { root.type(self.text); }
                }
            }

            HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 3;
                    characters: [".", "0", ":"];
                    typed(text) => { root.type(text); }
                }

                Key {
                    icon: @image-url("../icons/keyboard_return.svg");
                    key_style: KeyStyle.action;
                    clicked => { root.enter(); }
                }
            }
        }

        if !Keyboard.numeric: VerticalLayout {
            spacing: 4px;

            if root.layer == 0: Characters {
                vertical_stretch: 1;
                characters: ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"];
                upper: root.shifted;
                typed(text) => { root.type(text); }
            }

            if root.layer == 0: HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Rectangle {
                    horizontal_stretch: 0.5;
                }

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 9;
                    characters: ["a", "s", "d", "f", "g", "h", "j", "k", "l"];
                    upper: root.shifted;
                    typed(text) => { root.type(text); }
                }

                Rectangle {
                    horizontal_stretch: 0.5;
                }
            }

            if root.layer == 0: HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Key {
                    horizontal_stretch: 1.5;
                    icon: root.shifted ? @image-url("../icons/shift_fill1.svg") : @image-url("../icons/shift.svg");
                    key_style: KeyStyle.function;
                    clicked => { root.shifted = !root.shifted; }
                }

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 7;
                    characters: ["z", "x", "c", "v", "b", "n", "m"];
                    upper: root.shifted;
                    typed(text) => { root.type(text); }
                }

                Key {
                    horizontal_stretch: 1.5;
                    icon: @image-url("../icons/backspace.svg");
                    key_style: KeyStyle.function;
                    clicked => { Keyboard.key(Key.Backspace); }
                }
            }

            if root.layer == 1: Characters {
                vertical_stretch: 1;
                characters: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
                typed(text) => { root.type(text); }
            }

            if root.layer == 1: Characters {
                vertical_stretch: 1;
                characters: ["@", "#", "$", "_", "&", "-", "+", "(", ")", "/"];
                typed(text) => { root.type(text); }
            }

            if root.layer == 2: Characters {
                vertical_stretch: 1;
                characters: ["~", "`", "|", "\\", "<", ">", "{", "}", "[", "]"];
                typed(text) => { root.type(text); }
            }

            if root.layer == 2: Characters {
                vertical_stretch: 1;
                characters: ["%", "^", "=", "+", "-", "*", "/", "@", "#", "$"];
                typed(text) => { root.type(text); }
            }

            if root.layer != 0: HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Key {
                    horizontal_stretch: 1.5;
                    text: root.layer == 1 ? "=\\<" : "?123";
                    key_style: KeyStyle.function;
                    clicked => { root.layer = root.layer == 1 ? 2 : 1; }
                }

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 7;
                    characters: ["*", "\"", "'", ":", ";", "!", "?"];
                    typed(text) => { root.type(text); }
                }

                Key {
                    horizontal_stretch: 1.5;
                    icon: @image-url("../icons/backspace.svg");
                    key_style: KeyStyle.function;
                    clicked => { Keyboard.key(Key.Backspace); }
                }
            }

            HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Key {
                    horizontal_stretch: 1.5;
                    text: root.layer == 0 ? "?123" : "abc";
                    key_style: KeyStyle.function;
                    clicked => { root.layer = root.layer == 0 ? 1 : 0; }
                }

                Key {
                    text: root.layer == 0 ? "-" : ",";
                    clicked => { root.type(self.text); }
                }

                Key {
                    horizontal_stretch: 4;
                    text: " ";
                    clicked => { root.type(" "); }
                }

                Key {
                    text: ".";
                    clicked => { root.type(self.text); }
                }

                Key {
                    text: ":";
                    clicked => { root.type(self.text); }
                }

                Key {
                    horizontal_stretch: 1.5;
                    icon: @image-url("../icons/keyboard_return.svg");
                    key_style: KeyStyle.action;
                    clicked => { root.enter(); }
                }
            }
        }
    }
}
