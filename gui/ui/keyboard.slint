import { MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";
import { Keyboard } from "state.slint";

export enum KeyStyle {
    /// Types a character.
    letter,
    /// Changes what the keys type, or deletes.
    function,
    /// Enter, the key that finishes.
    action,
}

/// The colors of a key's face and its label, unpressed and pressed.
component KeyColors {
    in property <KeyStyle> key_style: KeyStyle.letter;
    in property <bool> pressed;

    out property <color> face: (root.key_style == KeyStyle.action ? MaterialPalette.primary
        : root.key_style == KeyStyle.function ? MaterialPalette.secondary_container
        : MaterialPalette.surface_container_highest).mix(self.ink, root.pressed ? 0.7 : 1.0);
    out property <color> ink: root.key_style == KeyStyle.action ? MaterialPalette.on_primary
        : root.key_style == KeyStyle.function ? MaterialPalette.on_secondary_container
        : MaterialPalette.on_surface;
}

/// A key on its own, with a label or an icon, lit while it is held. Most
/// keys are in rows of characters instead, which cost less.
component Key inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <KeyStyle> key_style: KeyStyle.letter;

    callback clicked();

    colors := KeyColors {
        key_style: root.key_style;
        pressed: touch.pressed;
    }

    // As wide as a character's key, unless given more
    horizontal_stretch: 1;
    border_radius: 8px;
    background: colors.face;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        source: root.icon;
        colorize: colors.ink;
    }

    Text {
        text: root.text;
        // Words, such as ?123, in a smaller size than single characters
        font_size: root.text.character_count > 1 ? 14px : 16px;
        color: colors.ink;
        horizontal_alignment: center;
        vertical_alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

/// A row of keys that type their own text, sharing the row's width. One
/// touch area serves the whole row, working out the key from where the
/// finger is, which costs much less than one for each key.
component Characters inherits Rectangle {
    in property <[string]> characters;
    in property <bool> upper;

    callback typed(string);

    /// Each key's share of the row, in whole pixels so that every key is
    /// the same width, and the pixels left over, split either side.
    property <length> slot: floor(self.width / root.characters.length / 1px) * 1px;
    property <length> margin: (self.width - root.slot * root.characters.length) / 2;
    /// The key being held, or -1.
    property <int> held: touch.pressed ? floor((touch.pressed_x - root.margin) / root.slot) : -1;

    for character[index] in root.characters: Rectangle {
        x: root.margin + index * root.slot + 2px;
        width: root.slot - 4px;
        border_radius: 8px;
        background: MaterialPalette.surface_container_highest.mix(MaterialPalette.on_surface, index == root.held ? 0.7 : 1.0);

        Text {
            text: root.upper ? character.to_uppercase() : character;
            font_size: 16px;
            color: MaterialPalette.on_surface;
            horizontal_alignment: center;
            vertical_alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            let index = floor((self.pressed_x - root.margin) / root.slot);
            if index >= 0 && index < root.characters.length {
                let character = root.characters[index];
                root.typed(root.upper ? character.to_uppercase() : character);
            }
        }
    }
}

/// A number pad, four keys by four, all exactly the same size. The digits
/// share one touch area, as rows of characters do.
component NumberPad inherits Rectangle {
    callback typed(string);
    callback backspace();
    callback enter();

    property <length> gap: 4px;
    /// One cell, in whole pixels, so every key is the same size, and the
    /// grid centred in the pixels left over.
    property <length> cell_width: floor((self.width - 3 * root.gap) / 4 / 1px) * 1px;
    property <length> cell_height: floor((self.height - 3 * root.gap) / 4 / 1px) * 1px;
    property <length> left: (self.width - 4 * root.cell_width - 3 * root.gap) / 2;
    property <length> top: (self.height - 4 * root.cell_height - 3 * root.gap) / 2;
    property <[string]> characters: ["1", "2", "3", "4", "5", "6", "7", "8", "9", ".", "0", ":"];
    /// The digit key being held, or -1.
    property <int> held: touch.pressed ? root.cell_at(touch.pressed_x, touch.pressed_y) : -1;

    /// The digit key at a point, or -1.
    pure function cell_at(x: length, y: length) -> int {
        let column = floor((x - root.left) / (root.cell_width + root.gap));
        let row = floor((y - root.top) / (root.cell_height + root.gap));
        if column < 0 || column > 2 || row < 0 || row > 3 {
            return -1;
        }
        return row * 3 + column;
    }

    for character[index] in root.characters: Rectangle {
        x: root.left + mod(index, 3) * (root.cell_width + root.gap);
        y: root.top + floor(index / 3) * (root.cell_height + root.gap);
        width: root.cell_width;
        height: root.cell_height;
        border_radius: 8px;
        background: MaterialPalette.surface_container_highest.mix(MaterialPalette.on_surface, index == root.held ? 0.7 : 1.0);

        Text {
            text: character;
            font_size: 16px;
            color: MaterialPalette.on_surface;
            horizontal_alignment: center;
            vertical_alignment: center;
        }
    }

    touch := TouchArea {
        x: root.left;
        width: 3 * (root.cell_width + root.gap);

        clicked => {
            let index = root.cell_at(self.x + self.pressed_x, self.pressed_y);
            if index >= 0 {
                root.typed(root.characters[index]);
            }
        }
    }

    Key {
        x: root.left + 3 * (root.cell_width + root.gap);
        y: root.top;
        width: root.cell_width;
        height: root.cell_height;
        icon: @image-url("../icons/backspace.svg");
        key_style: KeyStyle.function;
        clicked => { root.backspace(); }
    }

    Key {
        x: root.left + 3 * (root.cell_width + root.gap);
        y: root.top + root.cell_height + root.gap;
        width: root.cell_width;
        height: root.cell_height;
        text: "-";
        key_style: KeyStyle.function;
        clicked => { root.typed(self.text); }
    }

    Key {
        x: root.left + 3 * (root.cell_width + root.gap);
        y: root.top + 2 * (root.cell_height + root.gap);
        width: root.cell_width;
        height: root.cell_height;
        text: "+";
        key_style: KeyStyle.function;
        clicked => { root.typed(self.text); }
    }

    Key {
        x: root.left + 3 * (root.cell_width + root.gap);
        y: root.top + 3 * (root.cell_height + root.gap);
        width: root.cell_width;
        height: root.cell_height;
        icon: @image-url("../icons/keyboard_return.svg");
        key_style: KeyStyle.action;
        clicked => { root.enter(); }
    }
}

/// The keyboard, over the whole screen, with the setting being typed
/// shown at the top, as on a phone held sideways.
export component OnScreenKeyboard inherits Rectangle {
    /// Shift lasts one letter.
    property <bool> shifted;
    /// 0 for letters, 1 for digits and symbols, 2 for more symbols.
    property <int> layer;
    /// The width of a key of one character in the bottom row, and of the
    /// wider ones beside the space bar and in the row above, in whole
    /// pixels, so that keys of a size match exactly. The bottom row is ten
    /// of these with five gaps.
    property <length> unit: floor((self.width - 4px - 5 * 4px) / 10 / 1px) * 1px;
    property <length> wide: round(root.unit * 1.5 / 1px) * 1px;
    /// The height of each row of keys but the last, which takes what is
    /// left: the screen below the text being typed, in four rows.
    property <length> row_height: floor((root.height - 2 * 2px - 44px - 4 * 4px) / 4 / 1px) * 1px;

    function type(text: string) {
        Keyboard.key(text);
        root.shifted = false;
    }

    function enter() {
        Keyboard.key(Key.Return);
    }

    background: MaterialPalette.surface_container;

    VerticalLayout {
        padding: 2px;
        spacing: 4px;

        HorizontalLayout {
            height: 44px;
            padding_left: 8px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                horizontal_stretch: 1;

                MaterialText {
                    text: Keyboard.error != "" ? Keyboard.error : Keyboard.label;
                    style: MaterialTypography.label_medium;
                    color: Keyboard.error != "" ? MaterialPalette.error : MaterialPalette.primary;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 1px;

                    MaterialText {
                        text: Keyboard.text;
                        style: MaterialTypography.body_large;
                    }

                    // The cursor, always at the end
                    Rectangle {
                        width: 2px;
                        background: MaterialPalette.primary;
                    }
                }
            }

            Key {
                width: 56px;
                icon: @image-url("../icons/close.svg");
                key_style: KeyStyle.function;

                clicked => {
                    Keyboard.cancel();
                }
            }
        }

        if Keyboard.numeric: NumberPad {
            vertical_stretch: 1;
            typed(text) => { root.type(text); }
            backspace => { Keyboard.key(Key.Backspace); }
            enter => { root.enter(); }
        }

        if !Keyboard.numeric: VerticalLayout {
            spacing: 4px;

            if root.layer == 0: Characters {
                height: root.row_height;
                characters: ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"];
                upper: root.shifted;
                typed(text) => { root.type(text); }
            }

            if root.layer == 0: HorizontalLayout {
                height: root.row_height;
                spacing: 4px;

                Rectangle {
                    horizontal_stretch: 0.5;
                }

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 9;
                    characters: ["a", "s", "d", "f", "g", "h", "j", "k", "l"];
                    upper: root.shifted;
                    typed(text) => { root.type(text); }
                }

                Rectangle {
                    horizontal_stretch: 0.5;
                }
            }

            if root.layer == 0: HorizontalLayout {
                height: root.row_height;
                spacing: 4px;

                Key {
                    width: root.wide;
                    icon: root.shifted ? @image-url("../icons/shift_fill1.svg") : @image-url("../icons/shift.svg");
                    key_style: KeyStyle.function;
                    clicked => { root.shifted = !root.shifted; }
                }

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 7;
                    characters: ["z", "x", "c", "v", "b", "n", "m"];
                    upper: root.shifted;
                    typed(text) => { root.type(text); }
                }

                Key {
                    width: root.wide;
                    icon: @image-url("../icons/backspace.svg");
                    key_style: KeyStyle.function;
                    clicked => { Keyboard.key(Key.Backspace); }
                }
            }

            if root.layer == 1: Characters {
                height: root.row_height;
                characters: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
                typed(text) => { root.type(text); }
            }

            if root.layer == 1: Characters {
                height: root.row_height;
                characters: ["@", "#", "$", "_", "&", "-", "+", "(", ")", "/"];
                typed(text) => { root.type(text); }
            }

            if root.layer == 2: Characters {
                height: root.row_height;
                characters: ["~", "`", "|", "\\", "<", ">", "{", "}", "[", "]"];
                typed(text) => { root.type(text); }
            }

            if root.layer == 2: Characters {
                height: root.row_height;
                characters: ["%", "^", "=", "+", "-", "*", "/", "@", "#", "$"];
                typed(text) => { root.type(text); }
            }

            if root.layer != 0: HorizontalLayout {
                height: root.row_height;
                spacing: 4px;

                Key {
                    width: root.wide;
                    text: root.layer == 1 ? "=\\<" : "?123";
                    key_style: KeyStyle.function;
                    clicked => { root.layer = root.layer == 1 ? 2 : 1; }
                }

                Characters {
                    vertical_stretch: 1;
                    horizontal_stretch: 7;
                    characters: ["*", "\"", "'", ":", ";", "!", "?"];
                    typed(text) => { root.type(text); }
                }

                Key {
                    width: root.wide;
                    icon: @image-url("../icons/backspace.svg");
                    key_style: KeyStyle.function;
                    clicked => { Keyboard.key(Key.Backspace); }
                }
            }

            HorizontalLayout {
                vertical_stretch: 1;
                spacing: 4px;

                Key {
                    width: root.wide;
                    text: root.layer == 0 ? "?123" : "abc";
                    key_style: KeyStyle.function;
                    clicked => { root.layer = root.layer == 0 ? 1 : 0; }
                }

                Key {
                    width: root.unit;
                    text: root.layer == 0 ? "-" : ",";
                    clicked => { root.type(self.text); }
                }

                Key {
                    horizontal_stretch: 4;
                    text: " ";
                    clicked => { root.type(" "); }
                }

                Key {
                    width: root.unit;
                    text: ".";
                    clicked => { root.type(self.text); }
                }

                Key {
                    width: root.unit;
                    text: ":";
                    clicked => { root.type(self.text); }
                }

                Key {
                    width: root.wide;
                    icon: @image-url("../icons/keyboard_return.svg");
                    key_style: KeyStyle.action;
                    clicked => { root.enter(); }
                }
            }
        }
    }
}
