import { MaterialPalette, MaterialTypography } from "@material/material.slint";
import { App, Launcher } from "state.slint";
import { Scroller } from "widgets.slint";

/// An app's icon, with its name under it.
component AppTile {
    in property <image> icon;
    in property <string> text;
    /// A count of what is new in it, shown when more than none.
    in property <int> badge;

    callback clicked();

    width: 72px;
    height: 88px;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 8px;
        width: 56px;
        height: 56px;
        border_radius: 16px;
        background: touch.pressed ? MaterialPalette.primary_container.mix(MaterialPalette.on_primary_container, 0.85) : MaterialPalette.primary_container;

        Image {
            width: 28px;
            height: 28px;
            source: root.icon;
            colorize: MaterialPalette.on_primary_container;
        }

        if root.badge > 0: Rectangle {
            x: parent.width - self.width + 4px;
            y: -4px;
            width: max(16px, count.preferred_width + 8px);
            height: 16px;
            border_radius: self.height / 2;
            background: MaterialPalette.error;

            count := Text {
                text: root.badge;
                font_size: MaterialTypography.label_small.font_size;
                font_weight: MaterialTypography.label_small.font_weight;
                color: MaterialPalette.on_error;
            }
        }
    }

    Text {
        y: 70px;
        height: 16px;
        text: root.text;
        font_size: MaterialTypography.label_medium.font_size;
        font_weight: MaterialTypography.label_medium.font_weight;
        color: MaterialPalette.on_surface;
        horizontal_alignment: center;
        overflow: elide;
    }
}

/// The apps, in rows as wide as the screen allows.
export component LauncherPage inherits Scroller {
    property <length> tile_width: 72px;
    property <length> tile_height: 88px;
    property <int> columns: max(1, floor((root.width - 16px) / root.tile_width));

    content_height: 16px + ceil(Launcher.apps.length / root.columns) * root.tile_height;

    for app[index] in Launcher.apps: AppTile {
        x: 8px + mod(index, root.columns) * root.tile_width;
        y: 8px + floor(index / root.columns) * root.tile_height;
        icon: app == App.console ? @image-url("../icons/terminal.svg")
            : app == App.irc ? @image-url("../icons/tag.svg")
            : app == App.gopher ? @image-url("../icons/description.svg")
            : app == App.gemini ? @image-url("../icons/rocket_launch.svg")
            : @image-url("../icons/network_ping.svg");
        text: app == App.console ? "Console" : app == App.irc ? "IRC" : app == App.gopher ? "Gopher" : app == App.gemini ? "Gemini" : "Ping";
        badge: app == App.console ? Launcher.console_unread : app == App.irc ? Launcher.irc_unread : 0;

        clicked => {
            Launcher.open = app;
        }
    }
}
