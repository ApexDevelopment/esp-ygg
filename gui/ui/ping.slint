import { ListView, MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";
import { NodeChooser } from "chooser.slint";
import { AppBar, Row } from "page.slint";
import { App, Launcher, Ping } from "state.slint";
import { Button, ButtonKind } from "widgets.slint";

/// A ping a second to one node, with each round trip, newest first.
export component PingPage inherits VerticalLayout {
    if Ping.choosing: NodeChooser {
        pick(node) => {
            Ping.choosing = false;
            Ping.pick(node);
        }

        other => {
            Ping.choosing = false;
            Ping.type_address();
        }

        cancel => {
            Ping.choosing = false;
        }
    }

    if !Ping.choosing: VerticalLayout {
        AppBar {
            text: "Ping";

            back => {
                Ping.stop();
                Launcher.open = App.none;
            }

            if Ping.target != "": VerticalLayout {
                alignment: center;

                Button {
                    text: Ping.running ? "Stop" : "Start";
                    kind: ButtonKind.text;

                    clicked => {
                        if Ping.running {
                            Ping.stop();
                        } else {
                            Ping.start();
                        }
                    }
                }
            }
        }

        Row {
            text: Ping.target == "" ? "Choose a node" : Ping.target;
            supporting_text: Ping.summary;
            clickable: true;

            clicked => {
                Ping.choosing = true;
            }
        }

        ListView {
            for line in Ping.log: HorizontalLayout {
                padding_left: 16px;
                padding_right: 16px;
                height: 24px;

                MaterialText {
                    text: line;
                    style: MaterialTypography.body_medium;
                    color: MaterialPalette.on_surface_variant;
                    vertical_alignment: center;
                }
            }
        }
    }
}
