import { ListView, MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";
import { AppBar, EmptyNote, PageTitle, Row } from "page.slint";
import { App, Launcher, Node, Ping } from "state.slint";
import { Button, ButtonKind } from "widgets.slint";

/// The nodes to ping, or a way to type an address.
component TargetChooser inherits VerticalLayout {
    HorizontalLayout {
        PageTitle {
            horizontal_stretch: 1;
            text: "Nodes";
        }

        Button {
            text: "Cancel";
            kind: ButtonKind.text;

            clicked => {
                Ping.choosing = false;
            }
        }
    }

    if Node.nodes.length == 0: EmptyNote {
        text: "None known yet";
    }

    ListView {
        for node in Node.nodes: Row {
            text: node.name;
            supporting_text: node.address;
            clickable: true;

            clicked => {
                Ping.choosing = false;
                Ping.pick(node);
            }
        }
    }

    Row {
        text: "Other address";
        clickable: true;

        clicked => {
            Ping.choosing = false;
            Ping.type_address();
        }
    }
}

/// A ping a second to one node, with each round trip, newest first.
export component PingPage inherits VerticalLayout {
    if Ping.choosing: TargetChooser { }

    if !Ping.choosing: VerticalLayout {
        AppBar {
            text: "Ping";

            back => {
                Ping.stop();
                Launcher.open = App.none;
            }

            if Ping.target != "": VerticalLayout {
                alignment: center;

                Button {
                    text: Ping.running ? "Stop" : "Start";
                    kind: ButtonKind.text;

                    clicked => {
                        if Ping.running {
                            Ping.stop();
                        } else {
                            Ping.start();
                        }
                    }
                }
            }
        }

        Row {
            text: Ping.target == "" ? "Choose a node" : Ping.target;
            supporting_text: Ping.summary;
            clickable: true;

            clicked => {
                Ping.choosing = true;
            }
        }

        ListView {
            for line in Ping.log: HorizontalLayout {
                padding_left: 16px;
                padding_right: 16px;
                height: 24px;

                MaterialText {
                    text: line;
                    style: MaterialTypography.body_medium;
                    color: MaterialPalette.on_surface_variant;
                    vertical_alignment: center;
                }
            }
        }
    }
}
