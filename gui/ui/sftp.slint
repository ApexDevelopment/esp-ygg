import { MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";
import { NodeChooser } from "chooser.slint";
import { AppBar, EmptyNote, Row } from "page.slint";
import { App, Launcher, Sftp } from "state.slint";
import { Button, ButtonKind, ListView } from "widgets.slint";

/// The shared folder's files, to send by tapping, and how sending and
/// receiving are going.
export component SftpPage inherits VerticalLayout {
    if Sftp.sending != "": NodeChooser {
        pick(node) => {
            Sftp.pick(node);
        }

        other => {
            Sftp.type_address();
        }

        cancel => {
            Sftp.sending = "";
        }
    }

    if Sftp.sending == "": VerticalLayout {
        AppBar {
            text: "SFTP";

            back => {
                Launcher.open = App.none;
            }
        }

        if Sftp.status != "": HorizontalLayout {
            padding_left: 16px;
            padding_right: 16px;
            padding_bottom: 4px;

            MaterialText {
                text: Sftp.status;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface_variant;
            }
        }

        if Sftp.files.length == 0: EmptyNote {
            text: "No files yet";
        }

        ListView {
            for file in Sftp.files: Row {
                text: file.name;
                supporting_text: file.size;
                clickable: true;

                clicked => {
                    Sftp.sending = file.name;
                }
            }
        }
    }
}

/// Asks, over whatever is showing, whether to let in a peer that wants
/// SFTP access.
export component AdmitDialog inherits Rectangle {
    background: MaterialPalette.scrim.transparentize(40%);

    // Taps outside the dialog do nothing.
    TouchArea { }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, 280px);
        height: layout.preferred_height;
        border_radius: 28px;
        background: MaterialPalette.surface_container_high;

        layout := VerticalLayout {
            padding: 24px;
            padding_bottom: 16px;
            spacing: 16px;

            MaterialText {
                text: "Allow SFTP from";
                style: MaterialTypography.title_medium;
            }

            MaterialText {
                text: Sftp.asking;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_surface_variant;
                wrap: char_wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Button {
                    text: "Decline";
                    kind: ButtonKind.text;

                    clicked => {
                        Sftp.admit(false);
                    }
                }

                Button {
                    text: "Accept";
                    kind: ButtonKind.text;

                    clicked => {
                        Sftp.admit(true);
                    }
                }
            }
        }
    }
}
