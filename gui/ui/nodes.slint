import { ListView, MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";
import { EmptyNote, PageTitle, Row } from "page.slint";
import { Node } from "state.slint";

export component NodesPage inherits VerticalLayout {
    PageTitle {
        text: "Nodes";
    }

    if Node.nodes.length == 0: EmptyNote {
        text: "None yet";
    }

    ListView {
        for node in Node.nodes: Row {
            text: node.name;
            supporting_text: node.address;

            trailing: node.peer ? peer.preferred_width : 0;

            peer := MaterialText {
                x: parent.width - self.width - 16px;
                width: self.preferred_width;
                height: parent.height;
                text: node.peer ? "peer" : "";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.primary;
                vertical_alignment: center;
            }
        }
    }
}
