import { FilledButton, ListView, MaterialPalette, MaterialText, MaterialTypography, OutlineButton, ScrollView, Switch, TextButton } from "@material/material.slint";
import { EmptyNote, PageTitle, Row } from "page.slint";
import { Setting, Setup } from "state.slint";

/// A heading over a group of settings.
component Section inherits HorizontalLayout {
    in property <string> text;

    padding_left: 16px;
    padding_right: 16px;
    padding_top: 16px;
    padding_bottom: 4px;

    MaterialText {
        text: root.text;
        style: MaterialTypography.title_small;
        color: MaterialPalette.primary;
    }
}

/// A setting that is on or off.
component SwitchRow inherits HorizontalLayout {
    in property <string> text;
    in_out property <bool> checked;

    padding_left: 16px;
    padding_right: 16px;
    spacing: 8px;
    height: 48px;

    MaterialText {
        text: root.text;
        style: MaterialTypography.body_large;
        vertical_alignment: center;
        horizontal_stretch: 1;
        overflow: elide;
    }

    VerticalLayout {
        alignment: center;
        horizontal_stretch: 0;

        Switch {
            checked <=> root.checked;
        }
    }
}

/// A setting typed in, showing its value, which opens the keyboard.
component TextRow inherits Row {
    in property <Setting> setting;
    in property <string> value;
    /// What to show when the value is empty.
    in property <string> empty: "None";

    supporting_text: root.value == "" ? root.empty : root.value;
    clickable: true;

    clicked => {
        Setup.edit(root.setting, root.text);
    }
}

/// The WiFi networks in range, to pick the bridge's from, or to type the
/// name of one that does not show.
component NetworkChooser inherits VerticalLayout {
    HorizontalLayout {
        PageTitle {
            horizontal_stretch: 1;
            text: "Networks";
        }

        TextButton {
            text: "Cancel";

            clicked => {
                Setup.choosing_network = false;
            }
        }
    }

    if Setup.scanning: EmptyNote {
        text: "Scanning…";
    }

    ListView {
        for network in Setup.networks: Row {
            text: network.ssid;
            supporting_text: "\{network.signal} dBm" + (network.secured ? "" : " · open");
            clickable: true;

            clicked => {
                Setup.pick_network(network);
            }
        }
    }

    Row {
        text: "Other network";
        clickable: true;

        clicked => {
            Setup.choosing_network = false;
            Setup.edit(Setting.ssid, "Network");
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    if Setup.choosing_network: NetworkChooser { }

    if !Setup.choosing_network: ScrollView {
        content_y <=> Setup.scroll;

        VerticalLayout {
            PageTitle {
                text: "Settings";
            }

            Section {
                text: "Node";
            }

            TextRow {
                text: "Name";
                setting: Setting.name;
                value: Setup.name;
            }

            TextRow {
                text: "Channel";
                setting: Setting.channel;
                value: Setup.channel;
            }

            TextRow {
                text: "Time zone";
                setting: Setting.time_zone;
                value: "UTC" + Setup.time_zone;
            }

            SwitchRow {
                text: "Status pages";
                checked <=> Setup.status_pages;
            }

            Section {
                text: "Bridge";
            }

            SwitchRow {
                text: "Join WiFi";
                checked <=> Setup.bridge;
            }

            if Setup.bridge: VerticalLayout {
                Row {
                    text: "Network";
                    supporting_text: Setup.ssid == "" ? "None" : Setup.ssid;
                    clickable: true;

                    clicked => {
                        Setup.choosing_network = true;
                        Setup.scan();
                    }
                }

                TextRow {
                    text: "Password";
                    setting: Setting.wifi_password;
                    value: Setup.wifi_password;
                }

                TextRow {
                    text: "Peer";
                    setting: Setting.peer;
                    value: Setup.peer;
                }
            }

            Section {
                text: "Hotspot";
            }

            SwitchRow {
                text: "Run hotspot";
                checked <=> Setup.hotspot;
            }

            if Setup.hotspot: VerticalLayout {
                TextRow {
                    text: "Name";
                    setting: Setting.hotspot_name;
                    value: Setup.hotspot_name;
                }

                TextRow {
                    text: "Password";
                    setting: Setting.hotspot_password;
                    value: Setup.hotspot_password;
                }
            }

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                FilledButton {
                    text: "Save & restart";

                    clicked => {
                        Setup.save();
                    }
                }

                OutlineButton {
                    text: "Export to SD";

                    clicked => {
                        Setup.export();
                    }
                }

                OutlineButton {
                    text: "Import from SD";

                    clicked => {
                        Setup.import();
                    }
                }
            }
        }
    }
}
