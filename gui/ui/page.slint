import { MaterialPalette, MaterialText, MaterialTypography } from "@material/material.slint";

/// The title at the top of a page.
export component PageTitle inherits HorizontalLayout {
    in property <string> text;

    padding_left: 16px;
    padding_right: 16px;
    padding_top: 12px;
    padding_bottom: 4px;

    MaterialText {
        text: root.text;
        style: MaterialTypography.title_medium;
    }
}

/// A word about why a list is empty.
export component EmptyNote inherits HorizontalLayout {
    in property <string> text;

    padding: 16px;

    MaterialText {
        text: root.text;
        style: MaterialTypography.body_medium;
        color: MaterialPalette.on_surface_variant;
    }
}

/// A row of a list, two lines tall, with room on the right for a mark,
/// which whoever uses the row places. Its parts are placed by hand, as
/// layouts cost memory in every row.
export component Row inherits Rectangle {
    in property <string> text;
    in property <string> supporting_text;
    /// Whether tapping it does something, and so lights up while held.
    in property <bool> clickable;
    /// How much room to leave on the right for a mark.
    in property <length> trailing;

    callback clicked();

    // The two lines, centred together
    property <length> lines_height: title.preferred_height + (root.supporting_text == "" ? 0 : supporting.preferred_height);

    height: 52px;
    // Material's pressed state, without its ripple, which costs a good deal
    // of memory for each row.
    background: touch.pressed ? MaterialPalette.on_surface.transparentize(0.9) : transparent;

    touch := TouchArea {
        enabled: root.clickable;

        clicked => {
            root.clicked();
        }
    }

    title := Text {
        x: 16px;
        y: (root.height - root.lines_height) / 2;
        width: root.width - 32px - (root.trailing > 0 ? root.trailing + 8px : 0);
        height: self.preferred_height;
        text: root.text;
        font_size: MaterialTypography.body_large.font_size;
        font_weight: MaterialTypography.body_large.font_weight;
        color: MaterialPalette.on_background;
        overflow: elide;
    }

    // Kept when empty, at no height, as one less part to build.
    supporting := Text {
        x: 16px;
        y: title.y + title.height;
        width: title.width;
        height: root.supporting_text == "" ? 0 : self.preferred_height;
        text: root.supporting_text;
        font_size: MaterialTypography.body_small.font_size;
        font_weight: MaterialTypography.body_small.font_weight;
        color: MaterialPalette.on_surface_variant;
        overflow: elide;
    }

    @children
}

/// The bar along the top of an app, with a way back to the launcher and
/// room on the right for actions.
export component AppBar inherits HorizontalLayout {
    in property <string> text;

    callback back();

    height: 48px;
    padding_right: 4px;

    TouchArea {
        width: 48px;

        clicked => {
            root.back();
        }

        Rectangle {
            width: 40px;
            height: 40px;
            border_radius: self.height / 2;
            background: parent.pressed ? MaterialPalette.on_surface.transparentize(0.9) : transparent;

            Image {
                width: 24px;
                height: 24px;
                source: @image-url("../icons/arrow_back.svg");
                colorize: MaterialPalette.on_surface;
            }
        }
    }

    MaterialText {
        horizontal_stretch: 1;
        text: root.text;
        style: MaterialTypography.title_medium;
        vertical_alignment: center;
        overflow: elide;
    }

    @children
}
