export struct NodeEntry {
    /// Its name, or its address until the name is known.
    name: string,
    /// Its address, under the name once there is one.
    address: string,
    /// Whether it is a direct peer.
    peer: bool,
}

export struct NeighborEntry {
    /// Its name, its address, or its MAC address before the handshake.
    name: string,
    has_signal: bool,
    /// From none to four.
    bars: int,
    /// In dBm.
    signal: int,
    /// The share of frames sent to it that went unacknowledged, or -1.
    loss: int,
    /// Still finishing the Yggdrasil handshake.
    linking: bool,
}

/// What the node reports, set from Rust.
export global Node {
    in property <string> name: "esp-ygg";
    /// Empty until the node has started.
    in property <string> address;
    in property <int> neighbor_count;
    in property <int> peer_count;
    in property <int> known_count;
    in property <string> uptime;
    /// In kilobytes.
    in property <int> free_memory;
    in property <[NodeEntry]> nodes;
    in property <[NeighborEntry]> neighbors;
}

export struct WifiEntry {
    ssid: string,
    /// In dBm.
    signal: int,
    secured: bool,
}

/// The settings being edited, as typed. Rust fills them in, and checks
/// them when they are saved or exported.
export global Setup {
    in_out property <string> name;
    in_out property <string> channel;
    in_out property <string> time_zone;
    in_out property <bool> status_pages;
    in_out property <bool> bridge;
    in_out property <string> ssid;
    in_out property <string> wifi_password;
    in_out property <string> peer;
    in_out property <bool> hotspot;
    in_out property <string> hotspot_name;
    in_out property <string> hotspot_password;

    /// Why each text will not do, or empty.
    in property <string> name_error;
    in property <string> channel_error;
    in property <string> time_zone_error;
    in property <string> ssid_error;
    in property <string> wifi_password_error;
    in property <string> peer_error;
    in property <string> hotspot_name_error;
    in property <string> hotspot_password_error;

    /// Whether the list of WiFi networks is showing in place of the
    /// settings, the networks a scan found, and whether it is still going.
    in_out property <bool> choosing_network;
    in property <[WifiEntry]> networks;
    in property <bool> scanning;

    callback save();
    callback export();
    callback import();
    callback scan();
}

/// A short message about the last action, shown for a few seconds.
export global Notice {
    in_out property <string> text;
}
