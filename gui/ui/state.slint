export struct NodeEntry {
    /// Its name, or its address until the name is known.
    name: string,
    /// Its address, under the name once there is one.
    address: string,
    /// Whether it is a direct peer.
    peer: bool,
}

export struct NeighborEntry {
    /// Its name, its address, or its MAC address before the handshake.
    name: string,
    has_signal: bool,
    /// From none to four.
    bars: int,
    /// In dBm.
    signal: int,
    /// The share of frames sent to it that went unacknowledged, or -1.
    loss: int,
    /// Still finishing the Yggdrasil handshake.
    linking: bool,
}

/// What the node reports, set from Rust.
export global Node {
    /// Empty until the node has started.
    in property <string> address;
    in property <string> uptime;
    in property <[NodeEntry]> nodes;
    in property <[NeighborEntry]> neighbors;
}

export enum App {
    none,
    ping,
    console,
    irc,
    gopher,
    gemini,
    sftp,
}

/// The app open on the home page, if any, over the launcher.
export global Launcher {
    in_out property <App> open;
    /// The apps this build has, in order.
    in property <[App]> apps: [App.ping];
    /// Messages to the console since it was last open.
    in property <int> console_unread;
    /// Lines in IRC conversations not yet looked at.
    in property <int> irc_unread;
}

/// The Ping app, run from Rust.
export global Ping {
    /// The node being pinged, by name or address, or empty before one is
    /// chosen.
    in property <string> target;
    in property <bool> running;
    /// How many pings were sent, answered, and how quickly.
    in property <string> summary;
    /// What became of each ping, newest first.
    in property <[string]> log;
    /// Whether the nodes to choose from are showing.
    in_out property <bool> choosing;

    callback pick(NodeEntry);
    /// Opens the keyboard for an address.
    callback type_address();
    callback start();
    callback stop();
}

export struct WifiEntry {
    ssid: string,
    /// In dBm.
    signal: int,
    secured: bool,
}

/// A line of a conversation.
export struct ChatEntry {
    /// Who sent it, or who it went to, or empty for what happened.
    from: string,
    text: string,
    /// Sent from here.
    mine: bool,
}

/// The UDP console, run from Rust.
export global Console {
    /// Who messages go to, by name or address, or empty before one is
    /// chosen.
    in property <string> target;
    /// Where messages are listened for.
    in property <int> port;
    /// Messages sent and received, newest first.
    in property <[ChatEntry]> log;
    /// Whether the nodes to choose from are showing.
    in_out property <bool> choosing;

    callback pick(NodeEntry);
    /// Opens the keyboard for an address.
    callback type_address();
    /// Opens the keyboard for a message.
    callback write();
}

export enum IrcField {
    server,
    nick,
    channel,
}

export struct IrcBuffer {
    /// A channel, a nick, or the server's own.
    name: string,
    unread: int,
}

/// The IRC client, run from Rust.
export global Irc {
    /// Whether connected, or connecting, rather than setting up.
    in property <bool> connected;
    in property <bool> connecting;
    /// The form to connect with.
    in property <string> server;
    in property <string> nick;
    in property <string> channel;
    in property <string> error;
    /// The conversation showing, its lines newest first, and the others.
    in property <string> buffer;
    in property <[ChatEntry]> lines;
    in property <[IrcBuffer]> buffers;
    in property <int> others_unread;
    /// Whether the conversations to switch between are showing.
    in_out property <bool> choosing;

    /// Opens the keyboard on a field of the form.
    callback edit(IrcField);
    callback connect();
    /// Opens the keyboard for a message, or a command such as /join.
    callback write();
    callback switch_to(string);
    /// Opens the keyboard for a channel to join.
    callback join();
    callback disconnect();
}

export enum LineStyle {
    text,
    /// A link that can be followed.
    link,
    /// A link that cannot be followed here.
    faint,
    heading,
    /// An item of a list, its bullet and all.
    item,
    quote,
    /// Laid out by its author, so cut off rather than wrapped.
    preformatted,
}

/// A row of a page, wrapped to the screen in Rust.
export struct PageLine {
    text: string,
    /// The link it is part of, or -1.
    link: int,
    style: LineStyle,
    /// How far in from the page's edge it starts.
    indent: length,
}

/// The Gopher browser, run from Rust.
export global Gopher {
    /// The page showing, or empty before one is.
    in property <string> address;
    in property <bool> loading;
    in property <string> error;
    in property <bool> can_go_back;
    in property <[PageLine]> lines;
    /// How far down the page is scrolled.
    in_out property <length> scroll;
    /// How wide lines may be, for Rust to wrap them to.
    in_out property <length> width;

    /// Opens the keyboard for an address.
    callback go();
    callback open(int);
    callback back();
}

/// The Gemini browser, run from Rust.
export global Gemini {
    /// The page showing, or empty before one is.
    in property <string> address;
    in property <bool> loading;
    in property <string> error;
    in property <bool> can_go_back;
    in property <[PageLine]> lines;
    /// How far down the page is scrolled.
    in_out property <length> scroll;
    /// How wide lines may be, for Rust to wrap them to.
    in_out property <length> width;

    /// Opens the keyboard for an address.
    callback go();
    callback open(int);
    callback back();
    /// Stops loading a page.
    callback stop();
}

export struct SftpFile {
    name: string,
    /// Its size, written for people.
    size: string,
}

/// SFTP, run from Rust.
export global Sftp {
    /// The files in the shared folder.
    in property <[SftpFile]> files;
    /// What is coming in or going out, or how the last ended.
    in property <string> status;
    /// Who wants to connect, until answered, or empty.
    in property <string> asking;
    /// The file chosen to send, while choosing where.
    in_out property <string> sending;

    callback pick(NodeEntry);
    /// Opens the keyboard for an address to send to.
    callback type_address();
    callback admit(bool);
}

/// The settings typed in, one at a time, on the keyboard.
export enum Setting {
    name,
    channel,
    time_zone,
    ssid,
    wifi_password,
    peer,
    hotspot_name,
    hotspot_password,
    sftp_password,
}

/// The settings being edited. Rust fills in the text shown for each, and
/// keeps the edits until they are saved.
export global Setup {
    in property <string> name;
    in property <string> channel;
    in property <string> time_zone;
    in property <string> ssid;
    in property <string> wifi_password;
    in property <string> peer;
    in property <string> hotspot_name;
    in property <string> hotspot_password;
    in property <string> sftp_password;
    in_out property <bool> status_pages;
    in_out property <bool> bridge;
    in_out property <bool> hotspot;
    /// Whether the board was built with SFTP, which has a password.
    in property <bool> sftp;
    /// Whether saving the edits restarts the board, which some need.
    in property <bool> restart;

    /// Whether the list of WiFi networks is showing in place of the
    /// settings, the networks a scan found, and whether it is still going.
    in_out property <bool> choosing_network;
    in property <[WifiEntry]> networks;
    in property <bool> scanning;

    /// How far the page is scrolled, kept while the keyboard replaces it.
    in_out property <length> scroll;

    /// Opens the keyboard on a setting, under the label given.
    callback edit(Setting, string);
    callback pick_network(WifiEntry);
    callback save();
    callback export();
    callback import();
    callback scan();
}

/// Whether the board is locked against input, which hides the interface.
export global Lock {
    in property <bool> locked;
}

/// A short message about the last action, shown for a few seconds.
export global Notice {
    in_out property <string> text;
}

/// The keyboard, and the setting being typed on it. Rust keeps the text,
/// and checks it when Enter is pressed.
export global Keyboard {
    in property <bool> open;
    in property <string> label;
    /// The end of the text, as far as fits, with dots for a password.
    in property <string> text;
    /// Why the text will not do, after Enter.
    in property <string> error;
    /// Takes numbers alone, so gets a number pad.
    in property <bool> numeric;

    /// A character, or Key.Backspace, or Key.Return to finish.
    callback key(string);
    /// The character at a place in a row of keys, in capitals if asked.
    callback key_at(string, int, bool);
    callback cancel();
}
