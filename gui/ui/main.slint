import { MaterialPalette, MaterialText, MaterialTypography, MaterialWindow, OutlinedCard } from "@material";
import { Palette } from "std-widgets.slint";
import "../fonts/Roboto-Regular.ttf";
import "../fonts/Roboto-Medium.ttf";

/// A count with what it counts, on a card.
component Stat inherits OutlinedCard {
    in property <int> count;
    in property <string> label;

    VerticalLayout {
        padding: 12px;
        spacing: 2px;

        MaterialText {
            text: root.count;
            style: MaterialTypography.headline_small;
        }

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_medium;
            color: MaterialPalette.on_surface_variant;
        }
    }
}

export component MainWindow inherits MaterialWindow {
    in property <string> name: "esp-ygg";
    /// Empty until the node has started.
    in property <string> address;
    in property <int> neighbors;
    in property <int> peers;
    in property <int> known;
    /// How long the board has been up, as text.
    in property <string> uptime;
    /// Free memory, in kilobytes.
    in property <int> free_memory;

    width: 320px;
    height: 240px;
    default_font_family: "Roboto";

    init => {
        Palette.color_scheme = ColorScheme.dark;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;

            MaterialText {
                text: root.name;
                style: MaterialTypography.title_large;
            }

            MaterialText {
                text: root.address == "" ? "Starting…" : root.address;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface_variant;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Stat {
                count: root.neighbors;
                label: "neighbors";
            }

            Stat {
                count: root.peers;
                label: "peers";
            }

            Stat {
                count: root.known;
                label: "known";
            }
        }

        MaterialText {
            text: "up \{root.uptime} · \{root.free_memory} KB free";
            style: MaterialTypography.body_small;
            color: MaterialPalette.on_surface_variant;
        }
    }
}
