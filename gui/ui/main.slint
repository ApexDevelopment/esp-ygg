import { MaterialPalette, MaterialText, MaterialTypography, MaterialWindow, NavigationItem } from "@material/material.slint";
import { Palette } from "std-widgets.slint";
import { ConsolePage } from "console.slint";
import { GopherPage } from "gopher.slint";
import { IrcPage } from "irc.slint";
import { LauncherPage } from "launcher.slint";
import { NeighborsPage } from "neighbors.slint";
import { OnScreenKeyboard } from "keyboard.slint";
import { NodesPage } from "nodes.slint";
import { PingPage } from "ping.slint";
import { CompactBar, CompactRail } from "rail.slint";
import { SettingsPage } from "settings.slint";
import { App, Keyboard, Launcher, Notice } from "state.slint";
export { App, ChatEntry, Console, Gopher, Irc, IrcBuffer, IrcField, Keyboard, Launcher, Node, NodeEntry, NeighborEntry, Notice, PageLine, Ping, Setting, Setup, WifiEntry } from "state.slint";
import "../fonts/Roboto-Regular.ttf";
import "../fonts/Roboto-Medium.ttf";

/// The page chosen in the navigation, filling the room beside it.
component Pages inherits VerticalLayout {
    in property <int> page;

    if root.page == 0 && Launcher.open == App.none: LauncherPage { }
    if root.page == 0 && Launcher.open == App.ping: PingPage { }
    if root.page == 0 && Launcher.open == App.console: ConsolePage { }
    if root.page == 0 && Launcher.open == App.irc: IrcPage { }
    if root.page == 0 && Launcher.open == App.gopher: GopherPage { }
    if root.page == 1: NodesPage { }
    if root.page == 2: NeighborsPage { }
    if root.page == 3: SettingsPage { }
}

/// A short message along the bottom, in the style of Material's snackbar,
/// which goes after a few seconds.
component NoticeBar inherits Rectangle {
    height: max(40px, message.preferred_height + 20px);
    border_radius: 4px;
    background: MaterialPalette.inverse_surface;

    message := MaterialText {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        text: Notice.text;
        style: MaterialTypography.body_medium;
        color: MaterialPalette.inverse_on_surface;
        vertical_alignment: center;
        wrap: word_wrap;
    }

    Timer {
        interval: 4s;
        running: Notice.text != "";

        triggered => {
            Notice.text = "";
        }
    }
}

/// The navigation runs down the side on a wide screen and along the
/// bottom on a tall one, leaving pages much the same room either way. It
/// keeps its own size, and the page takes the rest, so the navigation
/// stays put whatever the page holds.
export component MainWindow inherits MaterialWindow {
    /// Home, Nodes, Neighbors or Settings, in that order.
    in_out property <int> page;

    property <bool> portrait: self.height > self.width;
    property <[NavigationItem]> destinations: [
        {
            icon: @image-url("../icons/home.svg"),
            selected_icon: @image-url("../icons/home_fill1.svg"),
            text: "Home",
        },
        {
            icon: @image-url("../icons/lan.svg"),
            selected_icon: @image-url("../icons/lan_fill1.svg"),
            text: "Nodes",
        },
        {
            icon: @image-url("../icons/cell_tower.svg"),
            selected_icon: @image-url("../icons/cell_tower_fill1.svg"),
            text: "Radio",
        },
        {
            icon: @image-url("../icons/settings.svg"),
            selected_icon: @image-url("../icons/settings_fill1.svg"),
            text: "Settings",
        },
    ];

    preferred_width: 320px;
    preferred_height: 240px;
    default_font_family: "Roboto";

    init => {
        Palette.color_scheme = ColorScheme.dark;
    }

    // The keyboard covers the screen, so what is under it is let go while
    // it is up, to leave memory for it.
    if !Keyboard.open && !root.portrait: HorizontalLayout {
        CompactRail {
            horizontal_stretch: 0;
            items: root.destinations;
            current_index <=> root.page;
        }

        Pages {
            horizontal_stretch: 1;
            page: root.page;
        }
    }

    if !Keyboard.open && root.portrait: VerticalLayout {
        Pages {
            vertical_stretch: 1;
            page: root.page;
        }

        CompactBar {
            vertical_stretch: 0;
            items: root.destinations;
            current_index <=> root.page;
        }
    }

    if Notice.text != "": NoticeBar {
        x: root.portrait ? 8px : 88px;
        width: root.width - self.x - 8px;
        y: root.height - self.height - (root.portrait ? 88px : 8px);
    }

    if Keyboard.open: OnScreenKeyboard {
        width: root.width;
        height: root.height;
    }
}
